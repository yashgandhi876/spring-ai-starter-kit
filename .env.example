# Settings the app reads from environment variables.
# Docker Compose reads this file automatically when it is named .env.
# For ./gradlew bootRun, export the ones you need in your shell first.
# The defaults run fully local with Ollama, no API keys needed.

# ---- AI provider and models ----
# Chat provider: ollama | anthropic | openai
AI_PROVIDER=ollama
# Embedding provider for RAG: ollama | openai
EMBEDDING_PROVIDER=ollama
# 768 for nomic-embed-text (Ollama), 1536 for OpenAI text-embedding-3-small.
# Changing this later means re-creating the vector table (see README).
EMBEDDING_DIMENSIONS=768
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Host port for the Compose Ollama container. Change it if 11434 is already in use.
OLLAMA_PORT=11434
# Set this only for an Ollama server somewhere else; by default it follows OLLAMA_PORT.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Prompts ----
AI_SYSTEM_PROMPT=You are a helpful assistant inside a Spring Boot application. Answer clearly and concisely. If you do not know something, say so.

# ---- RAG tuning ----
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.0
# Keep only chunks within this score distance of the best match (1 keeps all).
# Stops documents that are not about the question from being sent and cited.
RAG_MAX_SCORE_GAP=0.15
RAG_CHUNK_SIZE=800
MAX_UPLOAD_SIZE=20MB

# ---- Branding ----
APP_NAME=Spring AI Starter Kit
APP_WELCOME_MESSAGE=Ask me anything, or upload a document and ask questions about it.
APP_ACCENT_COLOR="#2f6f4f"

# ---- Database ----
# Host port for the Compose Postgres container. Change it if 5432 is already in use
# (for example by a Postgres installed on your machine).
DB_PORT=5432
# Set this only for a database somewhere else; by default it follows DB_PORT.
# DB_URL=jdbc:postgresql://localhost:5432/starterkit
DB_USER=starterkit
DB_PASSWORD=starterkit
